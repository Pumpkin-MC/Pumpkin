interface event {
    use common.{block-pos, game-mode, hand, position, click-type};
    use item-stack.{item-stack};
    use enchantments.{enchantment};
    use damage-types.{damage-type};
    use screens.{screen};
    use player.{player};
    use text.{text-component};
    use %world.{%world};
    use java-packets.{serverbound-packet as java-serverbound-packet, clientbound-packet as java-clientbound-packet};
    use bedrock-packets.{serverbound-packet as bedrock-serverbound-packet, clientbound-packet as bedrock-clientbound-packet};
    use uuid.{uuid};
    use java-dialogs.{dialog};

    variant serverbound-packet {
        java(java-serverbound-packet),
        bedrock(bedrock-serverbound-packet),
        unknown,
    }

    variant clientbound-packet {
        java(java-clientbound-packet),
        bedrock(bedrock-clientbound-packet),
        unknown,
    }

    enum event-priority {
        highest,
        high,
        normal,
        low,
        lowest,
    }

    record player-join-event {
        player: player,
        join-message: text-component,
        cancelled: bool
    }

    record player-leave-event {
        player: player,
        leave-message: text-component,
        cancelled: bool
    }

    record player-login-event {
        player: player,
        kick-message: text-component,
        cancelled: bool
    }

    record player-chat-event {
        player: player,
        message: string,
        recipients: list<player>,
        signature: option<list<u8>>,
        cancelled: bool
    }

    record player-command-send-event {
        player: player,
        command: string,
        cancelled: bool
    }

    record player-permission-check-event {
        player: player,
        permission: string,
        permission-result: bool
    }

    record player-move-event {
        player: player,
        from-position: position,
        to-position: position,
        cancelled: bool
    }

    record player-teleport-event {
        player: player,
        from-position: position,
        to-position: position,
        cancelled: bool
    }

    record player-change-world-event {
        player: player,
        previous-world: %world,
        new-world: %world,
        position: position,
        yaw: f32,
        pitch: f32,
        cancelled: bool
    }

    record player-respawn-event {
        player: player,
        previous-world: %world,
        respawned-world: %world,
        position: position,
        yaw: f32,
        pitch: f32,
        alive: bool
    }

    record player-exp-change-event {
        player: player,
        amount: s32
    }

    record player-item-held-event {
        player: player,
        previous-slot: u8,
        new-slot: u8,
        cancelled: bool
    }

    record player-changed-main-hand-event {
        player: player,
        main-hand: hand
    }

    record player-gamemode-change-event {
        player: player,
        previous-gamemode: game-mode,
        new-gamemode: game-mode,
        cancelled: bool
    }

    record player-custom-payload-event {
        player: player,
        channel: string,
        data: list<u8>
    }

    enum player-fish-state {
        fishing,
        caught-fish,
        caught-entity,
        in-ground,
        failed-attempt,
        reel-in,
        bite,
    }

    record player-fish-event {
        player: player,
        caught-uuid: option<uuid>,
        caught-type: string,
        hook-uuid: uuid,
        state: player-fish-state,
        hand: hand,
        exp-to-drop: s32,
        cancelled: bool
    }

    record player-egg-throw-event {
        player: player,
        egg-uuid: uuid,
        hatching: bool,
        num-hatches: u8,
        hatching-type: string,
        cancelled: bool
    }

    enum entity-interaction-action {
        interact,
        attack,
        interact-at,
    }

    enum interact-action {
        left-click-block,
        left-click-air,
        right-click-air,
        right-click-block,
    }

    record player-interact-event {
        player: player,
        action: interact-action,
        clicked-pos: option<block-pos>,
        block: string,
        cancelled: bool
    }

    record player-toggle-sneak-event {
        player: player,
        is-sneaking: bool,
        cancelled: bool
    }

    record player-toggle-flight-event {
        player: player,
        is-flying: bool,
        cancelled: bool
    }

    record player-toggle-sprint-event {
        player: player,
        is-sprinting: bool,
        cancelled: bool
    }

    record player-interact-unknown-entity-event {
        player: player,
        entity-id: s32,
        action: entity-interaction-action,
        cancelled: bool
    }

    record inventory-click-event {
        player: player,
        window-type: option<screen>,
        click-type: click-type,
        slot: s16,
        raw-slot: s16,
        clicked-item: option<item-stack>,
        cursor: option<item-stack>,
        hotbar-button: s32,
        cancelled: bool
    }

    record inventory-close-event {
        player: player,
        window-type: option<screen>
    }

    record block-redstone-event {
        target-world: %world,
        state-id: u16,
        block-pos: block-pos,
        old-current: s32,
        new-current: s32,
        cancelled: bool
    }

    record block-break-event {
        player: option<player>,
        block: string,
        block-pos: block-pos,
        exp: u32,
        should-drop: bool,
        cancelled: bool
    }

    record block-burn-event {
        igniting-block: string,
        block: string,
        block-pos: block-pos,
        target-world: %world,
        cancelled: bool
    }

    record block-can-build-event {
        block-to-build: string,
        buildable: bool,
        player: player,
        block: string,
        cancelled: bool
    }

    record block-grow-event {
        target-world: %world,
        old-block: string,
        old-state-id: u16,
        new-block: string,
        new-state-id: u16,
        block-pos: block-pos,
        cancelled: bool
    }

    record block-place-event {
        player: player,
        block-placed: string,
        block-placed-against: string,
        block-pos: block-pos,
        can-build: bool,
        cancelled: bool
    }

    record bedrock-form-response-event {
        player: player,
        form-id: u32,
        response-data: option<string>,
    }

    record dialog-click-action-event {
        player: player,
        id: string,
        payload: option<list<u8>>,
        cancelled: bool,
    }

    record dialog-show-event {
        player: player,
        dialog: dialog,
        cancelled: bool,
    }

    record dialog-clear-event {
        player: player,
        cancelled: bool,
    }

    record server-command-event {
        command: string,
        cancelled: bool
    }

    record server-list-ping-address {
        host: string,
        port: u16
    }

    record server-list-ping-event {
        hostname: string,
        address: server-list-ping-address,
        motd: text-component,
        max-players: u32,
        num-players: u32,
        favicon: option<string>
    }

    enum server-load-type {
        startup,
        reload,
    }

    record server-load-event {
        load-type: server-load-type
    }

    record spawn-change-event {
        target-world: %world,
        previous-position: block-pos,
        previous-yaw: f32,
        previous-pitch: f32,
        new-position: block-pos,
        new-yaw: f32,
        new-pitch: f32
    }

    record server-broadcast-event {
        message: text-component,
        sender: text-component,
        cancelled: bool
    }

    record server-tick-start-event {
        tick: s32
    }

    record server-tick-end-event {
        tick: s32,
        duration-nanos: s64
    }

    record packet-received-event {
        player: player,
        packet: serverbound-packet,
        packet-id: s32,
        raw-payload: list<u8>,
        cancelled: bool
    }

    record packet-sent-event {
        player: player,
        packet: clientbound-packet,
        packet-id: s32,
        raw-payload: list<u8>,
        cancelled: bool
    }

    record player-interact-entity-event {
        player: player,
        entity-id: s32,
        action: entity-interaction-action,
        sneaking: bool,
        cancelled: bool
    }

    record chunk-load-event {
        target-world: %world,
        chunk-x: s32,
        chunk-z: s32,
        cancelled: bool
    }

    record chunk-save-event {
        target-world: %world,
        chunk-x: s32,
        chunk-z: s32,
        cancelled: bool
    }

    record chunk-send-event {
        target-world: %world,
        chunk-x: s32,
        chunk-z: s32,
        cancelled: bool
    }

    record entity-damage-event {
        entity-id: s32,
        damage: f32,
        damage-type: damage-type,
        cancelled: bool
    }

    record entity-death-event {
        entity-id: s32,
        dropped-exp: s32
    }

    record player-death-event {
        player: player,
        death-message: text-component,
        dropped-exp: s32,
        keep-inventory: bool,
        cancelled: bool
    }

    record entity-spawn-event {
        entity-id: s32,
        entity-type: string,
        position: position,
        target-world: %world,
        cancelled: bool
    }

    record entity-combust-event {
        entity-id: s32,
        duration-secs: f32,
        cancelled: bool
    }

    record entity-regain-health-event {
        entity-id: s32,
        amount: f32,
        cancelled: bool
    }

    record entity-air-change-event {
        entity-id: s32,
        amount: s32,
        cancelled: bool
    }

    record entity-breed-event {
        father-id: s32,
        mother-id: s32,
        child-id: s32,
        cancelled: bool
    }

    record entity-dismount-event {
        entity-id: s32,
        dismounted-id: s32,
        cancelled: bool
    }

    record entity-dye-event {
        entity-id: s32,
        color: string,
        player: option<player>,
        cancelled: bool
    }

    record entity-enter-love-mode-event {
        entity-id: s32,
        human-entity-id: option<s32>,
        ticks-in-love: s32,
        cancelled: bool
    }

    record entity-explode-event {
        entity-id: s32,
        position: position,
        yield-rate: f32,
        cancelled: bool
    }

    record entity-mount-event {
        entity-id: s32,
        mounted-id: s32,
        cancelled: bool
    }

    record entity-pickup-item-event {
        entity-id: s32,
        item-name: string,
        count: u8,
        cancelled: bool
    }

    record entity-portal-event {
        entity-id: s32,
        portal-pos: block-pos,
        cancelled: bool
    }

    record entity-resurrect-event {
        entity-id: s32,
        cancelled: bool
    }

    record entity-shoot-bow-event {
        entity-id: s32,
        weapon-name: string,
        force: f32,
        cancelled: bool
    }

    record entity-tame-event {
        entity-id: s32,
        owner: player,
        cancelled: bool
    }

    record entity-target-event {
        entity-id: s32,
        target-id: option<s32>,
        cancelled: bool
    }

    record entity-teleport-event {
        entity-id: s32,
        from-position: position,
        to-position: position,
        cancelled: bool
    }

    record entity-toggle-glide-event {
        entity-id: s32,
        is-gliding: bool,
        cancelled: bool
    }

    record entity-transform-event {
        entity-id: s32,
        new-entity-id: s32,
        transform-reason: string,
        cancelled: bool
    }

    record creature-spawn-event {
        entity-id: s32,
        entity-type: string,
        position: position,
        target-world: %world,
        spawn-reason: string,
        player: option<player>,
        cancelled: bool
    }

    record ender-dragon-change-phase-event {
        entity-id: s32,
        current-phase: string,
        new-phase: string,
        cancelled: bool
    }

    record entity-break-door-event {
        entity-id: s32,
        block-pos: block-pos,
        cancelled: bool
    }

    record entity-change-block-event {
        entity-id: s32,
        block-pos: block-pos,
        new-block: string,
        cancelled: bool
    }

    record entity-damage-by-block-event {
        entity-id: s32,
        damager-pos: option<block-pos>,
        damage: f32,
        cause: string,
        cancelled: bool
    }

    record entity-damage-by-entity-event {
        entity-id: s32,
        damager-id: s32,
        damage: f32,
        cause: string,
        cancelled: bool
    }

    record entity-drop-item-event {
        entity-id: s32,
        item-name: string,
        count: u8,
        cancelled: bool
    }

    record entity-enter-block-event {
        entity-id: s32,
        block-pos: block-pos,
        cancelled: bool
    }

    record entity-exhaustion-event {
        entity-id: s32,
        exhaustion: f32,
        cancelled: bool
    }

    record entity-interact-event {
        entity-id: s32,
        block-pos: block-pos,
        cancelled: bool
    }

    record entity-knockback-event {
        entity-id: s32,
        hit-by-id: option<s32>,
        knockback: position,
        cancelled: bool
    }

    record entity-place-event {
        entity-id: s32,
        block-pos: block-pos,
        block-name: string,
        cancelled: bool
    }

    record entity-pose-change-event {
        entity-id: s32,
        pose: string,
        cancelled: bool
    }

    record entity-potion-effect-event {
        entity-id: s32,
        effect-name: string,
        duration: s32,
        amplifier: u8,
        cancelled: bool
    }

    record entity-spell-cast-event {
        entity-id: s32,
        spell: string,
        cancelled: bool
    }

    record entity-target-living-entity-event {
        entity-id: s32,
        target-id: option<s32>,
        reason: string,
        cancelled: bool
    }

    record entity-toggle-swim-event {
        entity-id: s32,
        is-swimming: bool,
        cancelled: bool
    }

    record explosion-prime-event {
        entity-id: s32,
        radius: f32,
        fire: bool,
        cancelled: bool
    }

    record firework-explode-event {
        entity-id: s32,
        cancelled: bool
    }

    record food-level-change-event {
        entity-id: s32,
        food-level: u8,
        cancelled: bool
    }

    record item-despawn-event {
        entity-id: s32,
        cancelled: bool
    }

    record item-merge-event {
        entity-id: s32,
        target-id: s32,
        cancelled: bool
    }

    record item-spawn-event {
        entity-id: s32,
        position: position,
        item-name: string,
        cancelled: bool
    }

    record piglin-barter-event {
        entity-id: s32,
        input-item: item-stack,
        outcome: list<item-stack>,
        cancelled: bool
    }

    record projectile-hit-event {
        entity-id: s32,
        hit-position: position,
        hit-entity-id: option<s32>,
        cancelled: bool
    }

    record projectile-launch-event {
        entity-id: s32,
        shooter-id: option<s32>,
        cancelled: bool
    }

    record sheep-dye-wool-event {
        entity-id: s32,
        dye-color: u8,
        player-id: option<s32>,
        cancelled: bool
    }

    record sheep-regrow-wool-event {
        entity-id: s32,
        cancelled: bool
    }

    record slime-split-event {
        entity-id: s32,
        count: s32,
        cancelled: bool
    }

    record strider-temperature-change-event {
        entity-id: s32,
        is-shivering: bool,
        cancelled: bool
    }

    record villager-acquire-trade-event {
        entity-id: s32,
        recipe-index: s32,
        cancelled: bool
    }

    record villager-career-change-event {
        entity-id: s32,
        profession: string,
        reason: string,
        cancelled: bool
    }

    record villager-replenish-trade-event {
        entity-id: s32,
        restock-quantity: s32,
        cancelled: bool
    }

    record warden-anger-change-event {
        entity-id: s32,
        target-id: s32,
        old-anger: s32,
        new-anger: s32,
        cancelled: bool
    }

    record area-effect-cloud-apply-event {
        entity-id: s32,
        affected-entities: list<s32>,
        cancelled: bool
    }

    record arrow-body-count-change-event {
        entity-id: s32,
        old-amount: u32,
        new-amount: u32,
        cancelled: bool
    }

    record bat-toggle-sleep-event {
        entity-id: s32,
        is-awake: bool,
        cancelled: bool
    }

    record creeper-power-event {
        entity-id: s32,
        lightning-id: option<s32>,
        cause: string,
        cancelled: bool
    }

    record entity-combust-by-block-event {
        entity-id: s32,
        combuster: block-pos,
        duration: f32,
        cancelled: bool
    }

    record entity-combust-by-entity-event {
        entity-id: s32,
        combuster-id: s32,
        duration: f32,
        cancelled: bool
    }

    record entity-knockback-by-entity-event {
        entity-id: s32,
        hit-by-id: s32,
        force: f64,
        x: f64,
        z: f64,
        cancelled: bool
    }

    record entity-portal-enter-event {
        entity-id: s32,
        location: block-pos,
        cancelled: bool
    }

    record entity-portal-exit-event {
        entity-id: s32,
        from-pos: block-pos,
        to-pos: option<block-pos>,
        cancelled: bool
    }

    record entity-remove-event {
        entity-id: s32,
        cause: string,
        cancelled: bool
    }

    record entity-target-block-event {
        entity-id: s32,
        block-pos: block-pos,
        cancelled: bool
    }

    record entity-unleash-event {
        entity-id: s32,
        reason: string,
        cancelled: bool
    }

    record exp-bottle-event {
        entity-id: s32,
        experience: s32,
        location: block-pos,
        show-effect: bool,
        cancelled: bool
    }

    record horse-jump-event {
        entity-id: s32,
        power: f32,
        cancelled: bool
    }

    record lingering-potion-splash-event {
        entity-id: s32,
        location: block-pos,
        potion-item: string,
        cancelled: bool
    }

    record pig-zap-event {
        entity-id: s32,
        lightning-id: s32,
        pig-zombie-id: s32,
        cancelled: bool
    }

    record pig-zombie-anger-event {
        entity-id: s32,
        target-id: option<s32>,
        new-anger: s32,
        cancelled: bool
    }

    record potion-splash-event {
        entity-id: s32,
        location: block-pos,
        potion-item: string,
        affected-entities: list<s32>,
        cancelled: bool
    }

    record spawner-spawn-event {
        entity-id: s32,
        spawner-pos: block-pos,
        cancelled: bool
    }

    record trial-spawner-spawn-event {
        entity-id: s32,
        spawner-pos: block-pos,
        cancelled: bool
    }

    record villager-reputation-change-event {
        entity-id: s32,
        target-id: s32,
        reputation-change: s32,
        cancelled: bool
    }

    record player-item-consume-event {
        player: player,
        item-name: string,
        cancelled: bool
    }

    record player-item-damage-event {
        player: player,
        item-name: string,
        damage: s32,
        cancelled: bool
    }

    record player-drop-item-event {
        player: player,
        item-name: string,
        count: u8,
        cancelled: bool
    }

    record player-bed-enter-event {
        player: player,
        bed-pos: block-pos,
        cancelled: bool
    }

    record player-bed-leave-event {
        player: player,
        bed-pos: block-pos
    }

    record player-bucket-empty-event {
        player: player,
        block-pos: block-pos,
        bucket: string,
        cancelled: bool
    }

    record player-bucket-fill-event {
        player: player,
        block-pos: block-pos,
        bucket: string,
        cancelled: bool
    }

    record async-player-chat-event {
        player: player,
        message: string,
        format: text-component,
        cancelled: bool
    }

    record async-player-pre-login-event {
        player-name: string,
        player-uuid: string,
        ip-address: string,
        kick-message: text-component,
        cancelled: bool
    }

    record player-advancement-done-event {
        player: player,
        advancement-id: string,
        cancelled: bool
    }

    record player-animation-event {
        player: player,
        animation-type: string,
        cancelled: bool
    }

    record player-armor-stand-manipulate-event {
        player: player,
        armor-stand-id: s32,
        slot: u8,
        cancelled: bool
    }

    record player-bucket-entity-event {
        player: player,
        entity-id: s32,
        bucket-item: string,
        cancelled: bool
    }

    record player-changed-world-event {
        player: player,
        from-world: %world,
        to-world: %world,
        cancelled: bool
    }

    record player-channel-event {
        player: player,
        channel: string,
        cancelled: bool
    }

    record player-command-preprocess-event {
        player: player,
        command: string,
        cancelled: bool
    }

    record player-edit-book-event {
        player: player,
        slot: u32,
        pages: list<string>,
        title: option<string>,
        signing: bool,
        cancelled: bool
    }

    record player-elytra-boost-event {
        player: player,
        firework-id: s32,
        cancelled: bool
    }

    record player-exp-cooldown-change-event {
        player: player,
        new-cooldown: s32,
        cancelled: bool
    }

    record player-harvest-block-event {
        player: player,
        block-pos: block-pos,
        harvested-items: list<item-stack>,
        cancelled: bool
    }

    record player-hide-entity-event {
        player: player,
        entity-id: s32,
        cancelled: bool
    }

    record player-item-break-event {
        player: player,
        item-name: string
    }

    record player-item-mend-event {
        player: player,
        item-name: string,
        repair-amount: s32,
        exp-consumed: s32,
        cancelled: bool
    }

    record player-kick-event {
        player: player,
        reason: string,
        cancelled: bool
    }

    record player-leash-entity-event {
        player: player,
        entity-id: s32,
        holder-id: s32,
        cancelled: bool
    }

    record player-level-change-event {
        player: player,
        old-level: s32,
        new-level: s32
    }

    record player-locale-change-event {
        player: player,
        new-locale: string,
        cancelled: bool
    }

    record player-name-entity-event {
        player: player,
        entity-id: s32,
