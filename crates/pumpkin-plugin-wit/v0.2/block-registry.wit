/// Registration of custom blocks.
///
/// Vanilla blocks have the ids `0..get-vanilla-block-count()`, custom blocks get
/// `get-vanilla-block-count() + n` where `n` is the registration order. Their states follow the
/// vanilla states, starting at `get-vanilla-state-count()`. Ids follow registration order on this
/// server.
///
/// The states of a block are numbered like vanilla: properties sorted by name, the first one most
/// significant, values in declared order (`true` before `false`, integers min to max, enums as
/// listed). Six boolean properties give 64 states: index 0 is all `true`, index 63 all `false`.
///
/// Registration closes when the server starts accepting connections (after plugin load and
/// `server-load-event`) and needs the `registry.blocks` permission.
interface block-registry {
    /// Inclusive range of an integer property.
    record int-bounds {
        min: u8,
        max: u8,
    }

    /// The values a property can have.
    variant property-kind {
        /// `true` and `false`, in this order.
        boolean,
        /// The integers from `min` to `max`, as decimal strings.
        int-range(int-bounds),
        /// The listed values, lowercase `a-z 0-9 _`, in this order.
        enumeration(list<string>),
    }

    /// A block state property.
    record block-property {
        /// Lowercase `a-z 0-9 _`.
        name: string,
        kind: property-kind,
    }

    /// A property and one of its values. Booleans are `true` or `false`, integers decimal
    /// strings, enum properties one of their values.
    record property-value {
        name: string,
        value: string,
    }

    /// An axis aligned box in block units, `0..1` is the block itself.
    record block-box {
        min-x: f64,
        min-y: f64,
        min-z: f64,
        max-x: f64,
        max-y: f64,
        max-z: f64,
    }

    /// A collision or selection shape.
    variant block-shape {
        /// No shape.
        empty,
        /// The whole block.
        full-cube,
        /// A union of boxes, at most 64.
        boxes(list<block-box>),
    }

    enum connect-direction {
        north,
        south,
        east,
        west,
        up,
        down,
    }

    /// What a neighbour has to be to make a boolean property true.
    variant connect-target {
        /// A block of the same custom block.
        same-block,
        /// A block with this key (`minecraft:` is optional for vanilla blocks).
        block(string),
        /// A block in this tag, `namespace:path`.
        tag(string),
    }

    /// Sets the boolean property `property` to whether the neighbour in `direction` matches
    /// `target`, like fences do. Applied on placement and whenever that neighbour changes.
    /// Directions are in world space, `north` is `-z`.
    record connect-rule {
        property: string,
        direction: connect-direction,
        target: connect-target,
    }

    /// What breaking the block drops. Nothing drops when the tool is not correct for a block that
    /// `requires-correct-tool`.
    variant block-drops {
        /// One item of the item linked with `set-block-item`.
        self-item,
        nothing,
        /// The loot table with this key, for example `namespace:blocks/name`.
        loot-table(string),
    }

    /// A block to add to the block registry.
    record block-definition {
        /// Full resource location, `namespace:path`, lowercase, `a-z 0-9 _ - .` (and `/` in the
        /// path). The `minecraft` namespace is reserved.
        key: string,
        /// State properties, at most 32 and 16384 states in total.
        properties: list<block-property>,
        /// Values of the default state. Unlisted properties get their first value (`true` for
        /// booleans).
        default-state: list<property-value>,
        /// Time to mine, -1 for unbreakable. Vanilla `strength(hardness, resistance)`.
        hardness: f32,
        /// Explosion resistance.
        blast-resistance: f32,
        /// Vanilla `requiresCorrectToolForDrops()`. The correct tool comes from the block tags and
        /// the item's tool rules.
        requires-correct-tool: bool,
        /// Name of a vanilla sound type, for example `stone`.
        sound-type: string,
        /// Light level 0 to 15 that every state emits.
        luminance: u8,
        /// Vanilla `canOcclude`, false for `noOcclusion()`.
        can-occlude: bool,
        /// Vanilla `isSuffocating`: a full suffocating block hurts an entity whose head is inside.
        suffocating: bool,
        /// Whether a block placed against it replaces it, like grass does.
        replaceable: bool,
        /// Map colour id, 0 for none.
        map-color: u8,
        /// Stops mobs, items and projectiles. Player movement is client side.
        collision-shape: block-shape,
        /// The shape of the selection outline and the one a ray hits.
        selection-shape: block-shape,
        /// Properties that follow the neighbours. At most one rule per property.
        connect-rules: list<connect-rule>,
        drops: block-drops,
        /// Block tags to join, `namespace:path`, like `register-block-tag`. Joining
        /// `minecraft:needs_diamond_tool` also joins the lower tiers' `incorrect_for_*_tool` tags.
        tags: list<string>,
    }

    /// A block and its network ids.
    record block-entry {
        /// Full resource location.
        key: string,
        /// The block id.
        id: u32,
        /// The id of the first state, the states follow in state order.
        base-state-id: u32,
        state-count: u32,
        /// The item linked with `set-block-item`.
        item-id: option<u32>,
    }

    /// Registers a block and returns its id. The same definition again returns the same id, a
    /// different one for a known key fails.
    register-block: func(definition: block-definition) -> result<u32, string>;

    /// Adds entries (block keys or `#tag` references) to a block tag, creating it if needed. Used
    /// by the server for tool checks and sent to clients.
    register-block-tag: func(tag: string, entries: list<string>) -> result<_, string>;

    /// Makes `item-key` the item of a custom block: it places the block and `self-item` drops give
    /// it. Both must be registered. Repeating a link is fine.
    set-block-item: func(item-key: string, block-key: string) -> result<_, string>;

    /// Returns the id of a block by key, vanilla (`minecraft:` prefix optional) or custom.
    get-block-id: func(key: string) -> option<u32>;

    /// Returns the full resource location (`minecraft:` prefixed for vanilla) of a block id.
    get-block-key: func(id: u32) -> option<string>;

    /// Returns the number of vanilla blocks. This is also the id of the first custom block.
    get-vanilla-block-count: func() -> u32;

    /// Returns the number of vanilla block states. This is also the id of the first state of the
    /// first custom block.
    get-vanilla-state-count: func() -> u32;

    /// Returns the id of the state of a vanilla or custom block with these property values.
    /// Properties that are not listed have their default value. Unknown blocks, properties and
    /// values give none.
    get-state-id: func(block: string, properties: list<property-value>) -> option<u32>;

    /// Returns all custom blocks in id order.
    get-registered-blocks: func() -> list<block-entry>;
}
