interface item-stack {
    use attributes.{attribute, attribute-modifier};
    use data-components.{data-component};
    use enchantments.{attribute-modifier-slot, enchantment};
    use text.{text-component};

    /// Represents an enchantment and its level.
    record enchantment-value {
        enchantment: enchantment,
        level: u32,
    }

    /// Represents a custom enchantment and its level on an item stack.
    record custom-enchantment-value {
        enchantment-id: string,
        level: u32,
    }

    /// Represents an attribute modifier applied to an item stack for a specific slot.
    record item-attribute-modifier {
        attribute: attribute,
        modifier: attribute-modifier,
        slot: attribute-modifier-slot,
    }

    /// Represents a data component and its serialized value.
    record data-component-value {
        component: data-component,
        /// The serialized value of the component.
        value: list<u8>,
    }

    use common.{nbt-entry, nbt-tree, nbt-tag};

    resource item-stack {
        constructor(registry-key: string, count: u8);

        /// Returns the unique registry key of the item (e.g., "minecraft:diamond").
        get-registry-key: async func() -> string;
        
        /// Returns the number of items in the stack.
        get-count: async func() -> u8;
        /// Sets the number of items in the stack.
        set-count: async func(count: u8);

        /// Returns the maximum number of items that can be in this stack.
        get-max-count: async func() -> u8;

        /// Creates an independent copy of this item stack.
        clone: async func() -> item-stack;

        /// Creates a copy of this item stack with the specified count.
        with-count: async func(count: u8) -> item-stack;

        /// Checks whether this item stack has the same item type and data components as another stack (ignoring count).
        is-similar: async func(other: item-stack) -> bool;

        /// Returns the current durability damage on this item stack (0 if undamaged).
        get-damage: async func() -> s32;
        /// Sets the durability damage on this item stack.
        set-damage: async func(damage: s32);
        /// Applies `amount` durability damage to this item stack, respecting Unbreaking and unbreakable state.
        /// Returns `true` if the item broke and was depleted.
        damage-item: async func(amount: s32) -> bool;
        /// Returns the maximum durability damage this item stack can take (0 if not damageable).
        get-max-damage: async func() -> s32;
        /// Returns whether this item stack can take durability damage.
        is-damageable: async func() -> bool;
        /// Returns whether this item stack has the unbreakable component.
        is-unbreakable: async func() -> bool;
        /// Sets or removes the unbreakable component on this item stack.
        set-unbreakable: async func(unbreakable: bool);

        /// Returns whether this item belongs to the specified item tag (e.g. `"minecraft:pickaxes"` or `"#c:tools"`).
        has-tag: async func(tag: string) -> bool;
        /// Returns all item tags this item belongs to.
        get-tags: async func() -> list<string>;
        /// Returns whether this item stack is the correct tool to harvest drops from the specified block (e.g. `"minecraft:diamond_ore"`).
        is-correct-for-drops: async func(block-name: string) -> bool;
        /// Returns the mining speed multiplier of this item stack against the specified block (1.0 if no tool rule matches).
        get-mining-speed: async func(block-name: string) -> f32;

        /// Returns the anvil repair cost of this item stack.
        get-repair-cost: async func() -> s32;
        /// Sets the anvil repair cost of this item stack.
        set-repair-cost: async func(cost: s32);

        /// Returns the custom item model resource location override, if set.
        get-item-model: async func() -> option<string>;
        /// Sets or clears the custom item model resource location override.
        set-item-model: async func(model: option<string>);

        /// Returns the enchantment glint override, if set.
        get-enchantment-glint-override: async func() -> option<bool>;
        /// Sets or clears the enchantment glint override.
        set-enchantment-glint-override: async func(glint: option<bool>);

        /// Returns all enchantments on this item stack.
        get-enchantments: async func() -> list<enchantment-value>;
        /// Adds an enchantment to this item stack.
        add-enchantment: async func(enchantment: enchantment, level: u32);
        /// Removes an enchantment from this item stack.
        remove-enchantment: async func(enchantment: enchantment);

        /// Returns all custom enchantments on this item stack.
        get-custom-enchantments: async func() -> list<custom-enchantment-value>;
        /// Adds a custom enchantment to this item stack.
        add-custom-enchantment: async func(enchantment-id: string, level: u32);
        /// Removes a custom enchantment from this item stack.
        remove-custom-enchantment: async func(enchantment-id: string);
        /// Returns the level of a custom enchantment on this item stack, if present.
        get-custom-enchantment-level: async func(enchantment-id: string) -> option<u32>;
        /// Returns whether this item stack has a specific custom enchantment.
        has-custom-enchantment: async func(enchantment-id: string) -> bool;

        /// Returns all attribute modifiers on this item stack.
        get-attribute-modifiers: async func() -> list<item-attribute-modifier>;
        /// Adds an attribute modifier to this item stack.
        add-attribute-modifier: async func(modifier: item-attribute-modifier);
        /// Removes all attribute modifiers for a specific attribute from this item stack.
        remove-attribute-modifiers: async func(attribute: attribute);
        /// Clears all custom attribute modifiers from this item stack.
        clear-attribute-modifiers: async func();

        /// Returns the lore of this item stack.
        get-lore: async func() -> list<text-component>;
        /// Sets the lore of this item stack.
        set-lore: async func(lore: list<text-component>);
        /// Adds a line to the lore of this item stack.
        add-lore: async func(line: text-component);

        /// Returns the custom name of this item stack, if set.
        get-custom-name: async func() -> option<text-component>;
        /// Sets the custom name of this item stack.
        set-custom-name: async func(name: option<text-component>);

        /// Sets a namespaced custom data value on this item stack.
        set-custom-data: async func(namespace: string, key: string, value: nbt-tree);
        /// Returns a namespaced custom data value from this item stack, if set.
        get-custom-data: async func(namespace: string, key: string) -> option<nbt-tree>;
        /// Removes a namespaced custom data value from this item stack.
        remove-custom-data: async func(namespace: string, key: string);
        /// Returns whether this item stack has a namespaced custom data value.
        has-custom-data: async func(namespace: string, key: string) -> bool;

        /// Returns all data components on this item stack.
        get-components: async func() -> list<data-component-value>;
        /// Sets a data component on this item stack.
        set-component: async func(component: data-component, value: list<u8>);
        /// Removes a data component from this item stack.
        remove-component: async func(component: data-component);
    }

    /// Returns whether the item with `item-name` (e.g. `"minecraft:diamond_pickaxe"` or `"diamond_pickaxe"`) belongs to `tag` (e.g. `"#minecraft:pickaxes"` or `"c:tools"`).
    is-item-in-tag: func(item-name: string, tag: string) -> bool;

    /// Returns the registry keys of all items in `tag` (e.g. `"minecraft:pickaxes"` or `"c:ores"`).
    get-items-in-tag: func(tag: string) -> list<string>;

    /// Returns all item tags that the item with `item-name` belongs to.
    get-item-tags: func(item-name: string) -> list<string>;
}
