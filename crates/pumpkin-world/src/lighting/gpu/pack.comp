#version 450

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly buffer Dims {
    uint size_x;
    uint size_y;
    uint size_z;
    uint total;
    uint base;
    uint count;
    uint delta_count;
    uint pad0;
    uint bmin_x;
    uint bmin_y;
    uint bmin_z;
    uint pad1;
    uint bmax_x;
    uint bmax_y;
    uint bmax_z;
    uint pad2;
} dims;

layout(std430, set = 0, binding = 1) readonly buffer Props { uint props[]; };
layout(std430, set = 0, binding = 2) readonly buffer Src { uint src[]; };
layout(std430, set = 0, binding = 3) writeonly buffer Dst { uint dst[]; };

void main() {
    uint lin = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 64u
             + gl_LocalInvocationID.x;
    if (lin * 4u >= dims.count) {
        return;
    }
    uint w = dims.base / 4u + lin;
    uint v = 0u;
    for (uint k = 0u; k < 4u; ++k) {
        uint s = w * 4u + k;
        if (s < dims.total) {
            v |= (src[s] & 15u) << (k * 8u);
        }
    }
    dst[w] = v;
}
