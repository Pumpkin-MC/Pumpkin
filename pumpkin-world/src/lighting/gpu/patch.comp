#version 450

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly buffer Dims {
    uint size_x;
    uint size_y;
    uint size_z;
    uint total;
    uint base;
    uint count;
    uint delta_count;
    uint pad0;
    uint bmin_x;
    uint bmin_y;
    uint bmin_z;
    uint pad1;
    uint bmax_x;
    uint bmax_y;
    uint bmax_z;
    uint pad2;
} dims;

layout(std430, set = 0, binding = 1) buffer Props { uint props[]; };
layout(std430, set = 0, binding = 4) readonly buffer Deltas { uint deltas[]; };

void main() {
    uint lin = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 64u
             + gl_LocalInvocationID.x;
    if (lin >= dims.delta_count) {
        return;
    }
    uint idx = deltas[lin * 2u];
    if (idx >= dims.total) {
        return;
    }
    props[idx] = deltas[lin * 2u + 1u];
}
